# Shared by the tapes: font, colours, and the demo started off-camera.
# Each tape sets its own size first.
Set Shell "bash"
Set FontFamily "JetBrains Mono"
Set LineHeight 1.25
Set Padding 20
Set WindowBar Colorful
Set BorderRadius 10
Set TypingSpeed 90ms
Set Theme { "name": "demo", "background": "#1a1b26", "foreground": "#c0caf5", "cursor": "#c0caf5", "selection": "#33467c", "black": "#15161e", "red": "#f7768e", "green": "#9ece6a", "yellow": "#e0af68", "blue": "#7aa2f7", "magenta": "#bb9af7", "cyan": "#7dcfff", "white": "#a9b1d6", "brightBlack": "#414868", "brightRed": "#f7768e", "brightGreen": "#9ece6a", "brightYellow": "#e0af68", "brightBlue": "#7aa2f7", "brightMagenta": "#bb9af7", "brightCyan": "#7dcfff", "brightWhite": "#c0caf5" }
Hide
Type "export PATH=$PWD/bin:$PATH; clear; herdr-linear-kickoff demo --background=#1a1b26" Enter
Sleep 4s
Show
